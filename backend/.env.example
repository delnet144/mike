PORT=3001
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-s...-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r...-key
R2_BUCKET_NAME=mike

# Cloud providers (optional if using local LLM via Hermes)
GEMINI_API_KEY=***
ANTHROPIC_API_KEY=your-a...-key
OPENROUTER_API_KEY=your-o...-key
RESEND_API_KEY=***

# ---------------------------------------------------------------------------
# Local LLM / Hermes adapter (auto-detected if config.yaml exists)
# ---------------------------------------------------------------------------
# If Hermes is installed at ~/.hermes/, leaving these empty will auto-detect
# from config.yaml. Set them explicitly to override.
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_API_KEY=no-api-key
# HERMES_BASE_URL=http://localhost:8000/v1
# HERMES_API_KEY=no-api-key
